{
  "version": 2,
  "name": "traffic-arxiv-backfill",
  "description": "Backfill 2023+ coverage from arXiv. Complements traffic-monthly.json, which is OpenAlex-only and misses almost every conference paper after 2022.",
  "search": {
    "queries": [
      "traffic forecasting",
      "traffic flow prediction",
      "traffic prediction",
      "spatio-temporal traffic",
      "road traffic prediction"
    ],
    "sources": [
      "arxiv"
    ],
    "year_range": {
      "mode": "rolling",
      "lookback_years": 4
    },
    "limit_per_query": 60,
    "output_limit": 40
  },
  "post": {
    "rules": [
      {
        "id": "domain",
        "field": "title",
        "op": "any",
        "keywords": [
          "traffic",
          "transport",
          "road",
          "mobility",
          "flow",
          "congestion"
        ],
        "required": true,
        "exclude": false,
        "weight": 1.4
      },
      {
        "id": "intent",
        "field": "title",
        "op": "any",
        "keywords": [
          "forecast",
          "prediction",
          "predicting",
          "nowcast"
        ],
        "required": true,
        "exclude": false,
        "weight": 1.3
      },
      {
        "id": "method-boost",
        "field": "title",
        "op": "any",
        "keywords": [
          "graph",
          "spatio-temporal",
          "spatiotemporal",
          "transformer",
          "diffusion",
          "uncertainty",
          "mamba",
          "llm",
          "foundation",
          "few-shot",
          "prompt"
        ],
        "required": false,
        "exclude": false,
        "weight": 0.35
      },
      {
        "id": "non-road-exclude",
        "field": "title",
        "op": "any",
        "keywords": [
          "airspace",
          "air traffic",
          "aviation",
          "flight",
          "uav",
          "drone",
          "maritime",
          "shipping",
          "vessel",
          "power load",
          "ev load",
          "microgrid",
          "wireless",
          "charging lane",
          "network intrusion",
          "optical network",
          "cellular traffic",
          "network traffic",
          "gene",
          "protein",
          "weather",
          "precipitation"
        ],
        "required": false,
        "exclude": true,
        "weight": 0.0
      }
    ],
    "min_score": 2.0
  },
  "rank": {
    "recency_weight": 0.35,
    "source_weights": {
      "arxiv": 1.0
    },
    "tie_breakers": [
      "year_desc",
      "title_asc"
    ]
  },
  "runtime": {
    "max_requests": 40,
    "min_interval_seconds": 3.5,
    "max_retries": 3,
    "retry_base_seconds": 3.0,
    "cache_dir": ".cache/arxiv-backfill",
    "cache_ttl_hours": 24
  }
}
