---
/**
 * TrendsPage — interactive replacement for the static PNG charts in README.
 *
 * All series come from site/public/_data.json (generated by prepare-data.mjs
 * from updates/hotspots/*.json and updates/wordcloud/*.json) plus the paper
 * index. Charts are ECharts; every chart keeps a <details> data table.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TrendChart from '../components/TrendChart.astro';
import { ui, type Lang } from '../lib/i18n';
import { byYear, byTask } from '../lib/papers';
import { withBase } from '../lib/url';
import chartData from '../../public/_data.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const l = (p: string) => withBase(lang === 'zh' ? `/zh${p}` : p);

const yearSeries = byYear();
const hotspots = (chartData as any).hotspots as
  | { generatedUtc: string; topk: number; years: Record<string, { term: string; count: number }[]> }
  | null;
const wordcloud = (chartData as any).wordcloud as
  | { generatedUtc: string; file: string; topWords: [string, number][] }
  | null;

/* ---- yearly paper count (line) ---- */
const yearChart = {
  grid: { left: 44, right: 18, top: 20, bottom: 34 },
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: yearSeries.map(([y]) => String(y)), boundaryGap: false },
  yAxis: { type: 'value', splitLine: { lineStyle: { opacity: 0.15 } } },
  series: [
    {
      type: 'line',
      smooth: true,
      symbolSize: 6,
      areaStyle: { opacity: 0.12 },
      data: yearSeries.map(([, c]) => c),
    },
  ],
};

/* ---- task distribution (bar, horizontal) ---- */
const taskSeries = byTask();
const taskChart = {
  grid: { left: 130, right: 24, top: 12, bottom: 24 },
  tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
  xAxis: { type: 'value', splitLine: { lineStyle: { opacity: 0.15 } } },
  yAxis: { type: 'category', data: taskSeries.map(([k]) => k), axisLabel: { fontSize: 11 } },
  series: [{ type: 'bar', data: taskSeries.map(([, c]) => c), barMaxWidth: 16 }],
};

/* ---- hotspot heatmap: year x rank ---- */
let heatChart: Record<string, unknown> | null = null;
let hotspotFallback: { headers: string[]; rows: (string | number)[][] } | null = null;
if (hotspots) {
  const yearsList = Object.keys(hotspots.years).sort();
  const maxRank = hotspots.topk;
  const terms = new Set<string>();
  const cells: [number, number, number][] = [];
  yearsList.forEach((y, yi) => {
    (hotspots.years[y] ?? []).slice(0, maxRank).forEach((entry, ri) => {
      // y axis = rank position (inverted so rank 1 is on top), x axis = year
      cells.push([yi, maxRank - ri - 1, entry.count]);
      terms.add(entry.term);
    });
  });
  heatChart = {
    grid: { left: 48, right: 18, top: 18, bottom: 56 },
    tooltip: {
      formatter: (p: any) =>
        `${yearsList[p.value[0]]} · rank ${maxRank - p.value[1]}`,
    },
    xAxis: {
      type: 'category',
      data: yearsList,
      splitArea: { show: true },
      axisLabel: { fontSize: 10, interval: 0, rotate: 45 },
    },
    yAxis: { type: 'category', data: Array.from({ length: maxRank }, (_, i) => `#${i + 1}`), axisLabel: { fontSize: 10 } },
    visualMap: {
      min: 0,
      max: Math.max(1, ...cells.map((c) => c[2])),
      calculable: true,
      orient: 'horizontal',
      left: 'center',
      bottom: 0,
      itemHeight: 80,
      textStyle: { fontSize: 10 },
    },
    series: [
      {
        type: 'heatmap',
        data: cells,
        label: { show: false },
        emphasis: { itemStyle: { shadowBlur: 6, shadowColor: 'rgba(0,0,0,0.3)' } },
      },
    ],
  };
  hotspotFallback = {
    headers: [t.papers.year, 'rank 1', 'rank 2', 'rank 3'],
    rows: yearsList.map((y) => [
      y,
      ...(hotspots.years[y] ?? []).slice(0, 3).map((e) => `${e.term} (${e.count})`),
    ]),
  };
}

/* ---- monthly word cloud -> top-k bar ---- */
let wordChart: Record<string, unknown> | null = null;
let wordRows: (string | number)[][] = [];
if (wordcloud) {
  const top = [...wordcloud.topWords].sort((a, b) => b[1] - a[1]).slice(0, 20);
  wordRows = top.map(([w, c]) => [w, c]);
  wordChart = {
    grid: { left: 100, right: 24, top: 12, bottom: 24 },
    tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
    xAxis: { type: 'value', splitLine: { lineStyle: { opacity: 0.15 } } },
    yAxis: { type: 'category', data: top.map(([w]) => w), inverse: true, axisLabel: { fontSize: 10 } },
    series: [{ type: 'bar', data: top.map(([, c]) => c), barMaxWidth: 14 }],
  };
}
---

<BaseLayout
  lang={lang}
  title={`${t.trends.title} — ${t.siteName}`}
  description={t.trends.lead}
  route="trends"
>
  <div class="wrap" style="padding-top:28px">
    <h2>{t.trends.title}</h2>
    <p class="section-lead">{t.trends.lead}</p>

    <div class="chart-grid">
      <TrendChart
        id="trend-year"
        title={t.trends.byYear}
        spec={yearChart}
        height={280}
        tableLabel={t.fallbackTable}
        fallback={{ headers: [t.papers.year, 'n'], rows: yearSeries.map(([y, c]) => [y, c]) }}
      />
      <TrendChart
        id="trend-task"
        title={t.trends.byTask}
        spec={taskChart}
        height={280}
        tableLabel={t.fallbackTable}
        fallback={{ headers: [t.papers.task, 'n'], rows: taskSeries.map(([k, c]) => [k, c]) }}
      />
    </div>

    {
      heatChart && hotspotFallback && (
        <div style="margin-top:14px">
          <TrendChart
            id="trend-hotspots"
            title={t.trends.hotspots}
            hint={`top ${hotspots!.topk} terms per year`}
            spec={heatChart}
            height={380}
            tableLabel={t.fallbackTable}
            fallback={hotspotFallback}
          />
        </div>
      )
    }

    {
      wordChart && (
        <div style="margin-top:14px">
          <TrendChart
            id="trend-wordcloud"
            title={t.trends.wordcloud}
            hint={`top ${wordRows.length} terms`}
            spec={wordChart}
            height={420}
            tableLabel={t.fallbackTable}
            fallback={{ headers: ['term', 'count'], rows: wordRows }}
          />
        </div>
      )
    }

    <p class="result-count">
      {t.trends.noJs} · <a href={l('/lineage/')}>{t.lineage.title} →</a>
    </p>

    <noscript>
      <p class="notice">{t.trends.noJs}</p>
    </noscript>
  </div>
</BaseLayout>